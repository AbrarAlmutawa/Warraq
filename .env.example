# Copy this file to .env (repo root or apps/api) and fill in real values.
# Never commit .env.

# Required for the journal agent and all other LLM features.
ANTHROPIC_API_KEY=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000

# Model used by the journal agent's extraction step.
JOURNAL_EXTRACTION_MODEL=claude-sonnet-4-6

# Seconds before an LLM request times out.
LLM_TIMEOUT_SECONDS=60
