# Copy this file to .env (repo root or apps/api) and fill in real values.
# Never commit .env.

# Required for the journal agent and all other LLM features.
ANTHROPIC_API_KEY=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000

# Seconds before an LLM request times out.
LLM_TIMEOUT_SECONDS=60

# SQLite database file (default: apps/api/data/warraq.db).
# DATABASE_PATH=

# Load the demo journals into an empty database on startup.
SEED_DEMO_JOURNALS=true

# Largest manuscript upload allowed, in MB.
MAX_UPLOAD_MB=25

# Model per AI task (see docs/llmops.md).
JOURNAL_EXTRACTION_MODEL=claude-sonnet-5
SUGGESTIONS_MODEL=claude-sonnet-5
CITATION_MODEL=claude-haiku-4-5-20251001

# Reuse identical AI answers instead of paying for them again.
LLM_CACHE_ENABLED=true
